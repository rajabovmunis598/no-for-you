# Gmail: create an App Password and put it here (remove spaces if desired)
DEBUG=false
ALLOWED_HOSTS=your-domain.example,www.your-domain.example
DB_PATH=/app/data/db.sqlite3

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Google AI Studio / Gemini (never expose this value in frontend code)
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=20

# For local testing without SMTP, use:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
